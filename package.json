{
  "name": "juntial-agents-bk",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "start:api": "node src/server.js",
    "start:worker": "node src/worker.js",
    "seed": "node src/scripts/seed.js",
    "telegram:rewebhook": "node src/scripts/rewebhook.js",
    "start:all": "node src/all.js",
    "test": "node --test --test-force-exit --test-concurrency=1 --test-timeout=120000 \"test/**/*.test.mjs\"",
    "test:unit": "node --test --test-force-exit \"test/unit/*.test.mjs\"",
    "test:e2e": "node test/e2e/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^5.34.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "quickjs-emscripten": "^0.32.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  },
  "description": "JuntialAgents: agentes de IA (Telegram, web, empleados digitales), CRM, reglas y funciones. Identidad y organizaci\u00f3n: Juntial Center."
}
