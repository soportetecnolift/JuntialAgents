NODE_ENV=development
PORT=4000
PUBLIC_API_URL=https://api.tudominio.com      # URL pública (Telegram webhooks y OAuth callback)
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Base de datos PROPIA de JuntialAgents (distinta de la de Center)
MONGO_URI=mongodb://127.0.0.1:27017/juntial_agents
REDIS_URL=redis://localhost:6379

# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
SESSION_DAYS=30
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="JuntialAgents <no-reply@tudominio.com>"

# Transcripción de audio de respaldo (si el cliente usa Claude y no aporta clave OpenAI)
PLATFORM_OPENAI_KEY=
DEFAULT_CLAUDE_MODEL=claude-sonnet-5-5
DEFAULT_OPENAI_MODEL=gpt-4.1-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

WORKER_CONCURRENCY=50
LOG_LEVEL=info

# Acceso de administración: verificación en dos pasos obligatoria para el equipo
STAFF_MFA_REQUIRED=true

# Opcional: servidor propio de la Bot API de Telegram (https://github.com/tdlib/telegram-bot-api)
TELEGRAM_API_BASE=

# ── Juntial Center (identidad y organización) ──
CENTER_URL=http://localhost:4100          # juntial-center-bk
CENTER_WEB_URL=http://localhost:5174      # panel de Center
CENTER_APP_ID=juntialagents
CENTER_APP_SECRET=CAMBIA_ESTE_SECRETO     # el mismo que en CENTER_APPS del .env de Center
